# =============================================
# Vector Marketing Platform - Environment Config
# =============================================

# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@hostname/database?sslmode=require

# Redis (for BullMQ + rate limiting)
REDIS_URL=redis://localhost:6379

# =============================================
# Google OAuth (required for GA4 / Search Console)
# =============================================
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback

# =============================================
# Google Ads API
# =============================================
# Developer token from Google Ads API Center
GOOGLE_ADS_DEVELOPER_TOKEN=your-developer-token
# MCC (Manager) account ID (without dashes)
GOOGLE_ADS_LOGIN_CUSTOMER_ID=1234567890
# Target customer account ID(s) (comma-separated, without dashes)
GOOGLE_ADS_CUSTOMER_ID=9876543210

# =============================================
# Google Search Console
# =============================================
# Site URL format: https://example.com or sc-domain:example.com
GSC_SITE_URL=https://yourdomain.com

# =============================================
# Meta/Facebook OAuth
# =============================================
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
META_REDIRECT_URI=http://localhost:3001/api/auth/meta/callback

# =============================================
# DataForSEO API
# =============================================
# Get credentials from: https://app.dataforseo.com/api-access
DATAFORSEO_LOGIN=your-dataforseo-login
DATAFORSEO_PASSWORD=your-dataforseo-password

# =============================================
# PageSpeed Insights API
# =============================================
# Get API key from: https://console.cloud.google.com/apis/credentials
PAGESPEED_API_KEY=your-pagespeed-api-key

# =============================================
# GTM Configuration
# =============================================
GTM_CONTAINER_ID=GTM-XXXXXXX
# Server-side GTM endpoint (optional, for sGTM)
GTM_SERVER_URL=https://sgtm.yourdomain.com

# =============================================
# GA4 Measurement Protocol (Server-side)
# =============================================
# GA4 property measurement ID
GA4_MEASUREMENT_ID=G-XXXXXXXXXX
# API secret from GA4 Admin > Data Streams > Measurement Protocol
GA4_API_SECRET=your-measurement-protocol-secret
# Server-side GTM endpoint (optional)
SGTM_ENDPOINT=https://sgtm.yourdomain.com

# =============================================
# Google Ads Conversions
# =============================================
GOOGLE_ADS_CONVERSION_ID=AW-XXXXXXXXX
GOOGLE_ADS_CONVERSION_LABEL=AbCdEfGhIjKlMnOpQr

# =============================================
# Gemini AI (server-side only)
# =============================================
GEMINI_API_KEY=your-gemini-api-key

# =============================================
# Google Indexing API (for instant URL indexing)
# =============================================
# Create a service account in Google Cloud Console
# Enable the Indexing API for the project
# Download the JSON key and paste the entire JSON here (single line)
# Add the service account email as Owner in Search Console
GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@....iam.gserviceaccount.com",...}

# =============================================
# Token Encryption (32 bytes, base64 encoded for AES-256-GCM)
# =============================================
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=your-base64-encoded-32-byte-key

# =============================================
# Server Configuration
# =============================================
PORT=3001
NODE_ENV=development
APP_DOMAIN=localhost
